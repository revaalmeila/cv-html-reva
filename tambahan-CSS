<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Reva Almeila Putri | Portfolio</title>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

:root{
    --cream:#faf7ef;
    --cream2:#f1ead8;
    --yellow:#e4bd55;
    --gold:#b68a28;
    --dark:#292824;
    --gray:#777269;
    --line:#ded6c4;
    --white:#fff;
}

body{
    font-family:"DM Sans",sans-serif;
    background:var(--cream);
    color:var(--dark);
    overflow-x:hidden;
}

a{
    color:inherit;
    text-decoration:none;
}

/* ================= CURSOR ================= */

.cursor{
    position:fixed;
    width:12px;
    height:12px;
    border:1px solid var(--gold);
    border-radius:50%;
    pointer-events:none;
    z-index:9999;
    transform:translate(-50%,-50%);
    transition:.2s;
}

@media(max-width:600px){
    .cursor{display:none}
}

/* ================= NAVBAR ================= */

nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:75px;
    padding:0 7%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:#faf7efd9;
    backdrop-filter:blur(15px);
    border-bottom:1px solid #ddd5c4;
    z-index:1000;
}

.logo{
    font-size:21px;
    font-weight:600;
    letter-spacing:2px;
}

.logo span{
    color:var(--yellow);
}

.menu{
    display:flex;
    gap:28px;
}

.menu a{
    font-size:10px;
    letter-spacing:1px;
    color:#716b60;
    position:relative;
}

.menu a::after{
    content:"";
    position:absolute;
    left:0;
    bottom:-7px;
    width:0;
    height:1px;
    background:var(--yellow);
    transition:.3s;
}

.menu a:hover::after{
    width:100%;
}

/* ================= GENERAL ================= */

section{
    min-height:100vh;
    padding:120px 8% 90px;
    position:relative;
    overflow:hidden;
}

.section-label{
    color:var(--gold);
    font-size:10px;
    letter-spacing:4px;
    margin-bottom:18px;
}

.section-number{
    position:absolute;
    top:110px;
    right:8%;
    font-size:10px;
    letter-spacing:3px;
    color:#b2a990;
}

.section-title{
    font-family:"Playfair Display",serif;
    font-size:clamp(50px,7vw,85px);
    line-height:.9;
    font-weight:500;
    letter-spacing:-3px;
}

.section-title span{
    color:var(--yellow);
    font-style:italic;
}

/* ================= MOVING TEXT ================= */

.moving-text{
    width:100%;
    overflow:hidden;
    white-space:nowrap;
    position:absolute;
    left:0;
    bottom:20px;
    opacity:.45;
    pointer-events:none;
}

.moving-track{
    display:inline-block;
    animation:moveText 22s linear infinite;
    font-size:10px;
    letter-spacing:5px;
    color:#9c8960;
}

.moving-track span{
    margin:0 35px;
    color:var(--gold);
}

@keyframes moveText{
    from{transform:translateX(0)}
    to{transform:translateX(-50%)}
}

/* ================= HOME ================= */

#home{
    min-height:100vh;
    display:flex;
    align-items:center;
}

.home-circle{
    position:absolute;
    width:600px;
    height:600px;
    border-radius:50%;
    background:#f0dda4;
    right:-260px;
    top:-250px;
    opacity:.6;
}

.home-outline{
    position:absolute;
    width:300px;
    height:300px;
    border:1px solid #ddc77f;
    border-radius:50%;
    left:-150px;
    bottom:-100px;
}

.home-container{
    width:100%;
    display:grid;
    grid-template-columns:1.1fr .9fr;
    align-items:center;
    gap:70px;
    position:relative;
    z-index:2;
}

.home-text{
    animation:fadeUp 1s ease;
}

.small-title{
    font-size:10px;
    letter-spacing:4px;
    color:#8b8375;
    margin-bottom:25px;
}

.home-title{
    font-family:"Playfair Display",serif;
    font-size:clamp(70px,9vw,125px);
    line-height:.8;
    font-weight:500;
    letter-spacing:-7px;
}

.home-title span{
    color:var(--yellow);
    font-style:italic;
    margin-left:55px;
}

.home-identity{
    display:flex;
    align-items:center;
    gap:16px;
    margin:35px 0 25px;
}

.identity-line{
    width:75px;
    height:1px;
    background:var(--gold);
    position:relative;
    overflow:hidden;
}

.identity-line::after{
    content:"";
    position:absolute;
    width:75px;
    height:1px;
    background:var(--dark);
    left:-75px;
    animation:lineMove 3s infinite;
}

.identity-main{
    font-size:11px;
    letter-spacing:4px;
    font-weight:600;
}

.identity-campus{
    font-size:9px;
    letter-spacing:1.5px;
    color:#918a7b;
    margin-top:5px;
}

@keyframes lineMove{
    0%{left:-75px}
    50%,100%{left:75px}
}

.home-description{
    max-width:510px;
    color:var(--gray);
    font-size:14px;
    line-height:1.9;
}

.home-buttons{
    margin-top:30px;
    display:flex;
    gap:15px;
    align-items:center;
}

.main-button{
    background:var(--dark);
    color:white;
    padding:14px 24px;
    font-size:10px;
    letter-spacing:1px;
    transition:.3s;
}

.main-button:hover{
    background:var(--yellow);
    color:var(--dark);
    transform:translateY(-4px);
}

.text-link{
    font-size:10px;
    color:#716b60;
}

.home-location{
    margin-top:25px;
    font-size:9px;
    letter-spacing:2px;
    color:#aaa295;
}

/* HOME SYMBOL */

.float-symbol{
    position:absolute;
    color:var(--gold);
    animation:symbolFloat 4s ease-in-out infinite;
    z-index:5;
}

.f1{
    top:15%;
    left:45%;
    font-size:19px;
}

.f2{
    top:40%;
    right:3%;
    font-size:13px;
    animation-delay:1s;
}

.f3{
    bottom:20%;
    left:43%;
    font-size:15px;
    animation-delay:2s;
}

@keyframes symbolFloat{
    0%,100%{
        transform:translateY(0) rotate(0);
        opacity:.5;
    }
    50%{
        transform:translateY(-10px) rotate(8deg);
        opacity:1;
    }
}

/* ================= PHOTO ================= */

.photo-area{
    height:520px;
    position:relative;
    display:flex;
    justify-content:center;
    align-items:center;
    animation:fadeIn 1.3s ease;
}

.photo-circle{
    position:absolute;
    width:370px;
    height:370px;
    border-radius:50%;
    background:#e9d58f;
    right:5%;
}

.photo-outline{
    position:absolute;
    width:390px;
    height:390px;
    border:1px solid #d5b95d;
    border-radius:50%;
    right:-1%;
    top:80px;
    animation:rotate 12s linear infinite;
}

.photo-box{
    width:290px;
    height:390px;
    padding:9px;
    background:white;
    position:relative;
    z-index:3;
    transform:rotate(4deg);
    box-shadow:0 30px 60px rgba(50,45,30,.2);
    transition:.5s;
}

.photo-box:hover{
    transform:rotate(0) scale(1.03);
}

.photo-box img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.photo-label{
    position:absolute;
    right:0;
    bottom:65px;
    z-index:5;
    padding:12px 18px;
    background:var(--dark);
    color:white;
    font-size:9px;
    letter-spacing:3px;
}

@keyframes rotate{
    to{transform:rotate(360deg)}
}

/* ================= MARQUEE ================= */

.marquee{
    overflow:hidden;
    background:var(--dark);
    color:white;
    padding:16px 0;
    white-space:nowrap;
}

.marquee-track{
    display:inline-block;
    animation:marquee 20s linear infinite;
    font-size:10px;
    letter-spacing:4px;
}

.marquee span{
    color:var(--yellow);
    margin:0 35px;
}

@keyframes marquee{
    from{transform:translateX(0)}
    to{transform:translateX(-50%)}
}

/* ================= ABOUT ================= */

#about{
    background:var(--cream2);
}

.about-grid{
    margin-top:70px;
    display:grid;
    grid-template-columns:.8fr 1.2fr;
    gap:100px;
}

.about-intro{
    font-family:"Playfair Display",serif;
    font-size:31px;
    line-height:1.3;
}

.about-intro span{
    color:#b88924;
    font-style:italic;
}

.about-line{
    width:55px;
    height:3px;
    background:var(--yellow);
    margin:25px 0;
}

.about-text{
    color:#777166;
    font-size:14px;
    line-height:1.9;
    margin-top:20px;
}

.bio-card{
    background:#ffffff73;
    border:1px solid #ddd3bb;
}

.bio-item{
    display:grid;
    grid-template-columns:180px 1fr;
    padding:21px 25px;
    border-bottom:1px solid #ddd3bb;
}

.bio-item:last-child{
    border-bottom:none;
}

.bio-item span{
    color:#ad8127;
    font-size:9px;
    letter-spacing:2px;
}

.bio-item strong{
    font-size:13px;
    font-weight:500;
}

/* ================= EDUCATION ================= */

#education{
    background:var(--cream);
}

.education-header{
    display:flex;
    justify-content:space-between;
    align-items:end;
}

.education-description{
    max-width:350px;
    color:var(--gray);
    font-size:13px;
    line-height:1.8;
}

.timeline{
    margin-top:70px;
    max-width:1000px;
    margin-left:auto;
}

.timeline-item{
    display:grid;
    grid-template-columns:160px 20px 1fr;
    gap:25px;
    padding:35px 0;
    border-top:1px solid var(--line);
    transition:.3s;
}

.timeline-item:last-child{
    border-bottom:1px solid var(--line);
}

.timeline-item:hover{
    padding-left:15px;
}

.timeline-year{
    color:#b48728;
    font-size:10px;
    font-weight:600;
    letter-spacing:1px;
}

.timeline-dot{
    width:9px;
    height:9px;
    border-radius:50%;
    background:var(--yellow);
    margin-top:5px;
    box-shadow:0 0 0 6px #f5e8bd;
    animation:pulse 2s infinite;
}

.timeline-content h3{
    font-family:"Playfair Display",serif;
    font-size:24px;
    font-weight:500;
}

.timeline-content p{
    margin-top:6px;
    color:#888177;
    font-size:12px;
}

@keyframes pulse{
    50%{box-shadow:0 0 0 10px #f5e8bd33}
}

/* ================= SKILLS ================= */

#skills{
    background:#eee6d3;
}

.skills-wrapper{
    margin-top:70px;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.skill-card{
    min-height:210px;
    padding:25px;
    background:#faf7ef;
    border:1px solid #ded4bd;
    transition:.35s;
    position:relative;
    overflow:hidden;
}

.skill-card:hover{
    transform:translateY(-8px);
    box-shadow:0 20px 35px #3c321e14;
}

.skill-card::after{
    content:"✦";
    position:absolute;
    right:18px;
    top:18px;
    color:var(--yellow);
    animation:symbolFloat 3s infinite;
}

.skill-number{
    color:#c8a348;
    font-size:10px;
    letter-spacing:2px;
}

.skill-card h3{
    margin-top:55px;
    font-family:"Playfair Display",serif;
    font-size:25px;
    font-weight:500;
}

.skill-card p{
    margin-top:10px;
    color:#888176;
    font-size:12px;
    line-height:1.7;
}

/* ================= EXPERIENCE ================= */

#experience{
    background:var(--dark);
    color:white;
}

#experience .section-label{
    color:var(--yellow);
}

.experience-content{
    margin-top:65px;
    display:grid;
    grid-template-columns:100px 1fr;
    gap:35px;
    max-width:1000px;
    margin-left:auto;
}

.experience-number{
    font-size:12px;
    color:var(--yellow);
    letter-spacing:3px;
}

.experience-main{
    border-top:1px solid #555149;
    padding-top:30px;
}

.experience-main h3{
    font-family:"Playfair Display",serif;
    font-size:42px;
    font-weight:500;
}

.experience-main p{
    max-width:700px;
    color:#bdb8ad;
    font-size:14px;
    line-height:1.9;
    margin-top:20px;
}

.tech-list{
    margin-top:35px;
    display:flex;
    flex-wrap:wrap;
    gap:10px;
}

.tech{
    padding:9px 15px;
    border:1px solid #666157;
    color:#d8d2c7;
    font-size:9px;
    letter-spacing:1px;
    transition:.3s;
}

.tech:hover{
    background:var(--yellow);
    color:var(--dark);
}

/* ================= PROJECT ================= */

#project{
    background:#f5eddb;
}

.project-card{
    margin-top:65px;
    display:grid;
    grid-template-columns:1fr 1fr;
    min-height:400px;
    background:var(--dark);
    color:white;
    overflow:hidden;
}

.project-info{
    padding:55px;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

.project-number{
    color:var(--yellow);
    font-size:10px;
    letter-spacing:3px;
}

.project-info h3{
    font-family:"Playfair Display",serif;
    font-size:45px;
    font-weight:500;
    margin:20px 0;
}

.project-info p{
    color:#bdb8ad;
    font-size:13px;
    line-height:1.8;
    max-width:450px;
}

.project-visual{
    background:linear-gradient(135deg,#e7cd72,#cda945);
    display:flex;
    justify-content:center;
    align-items:center;
    position:relative;
}

.project-circle{
    width:220px;
    height:220px;
    border-radius:50%;
    background:#ffffff40;
    border:1px solid #ffffff80;
    display:flex;
    justify-content:center;
    align-items:center;
    font-family:"Playfair Display",serif;
    font-size:38px;
    color:white;
    animation:projectFloat 4s ease-in-out infinite;
}

.project-circle::after{
    content:"";
    position:absolute;
    width:270px;
    height:270px;
    border:1px solid #ffffff66;
    border-radius:50%;
}

@keyframes projectFloat{
    50%{transform:translateY(-12px)}
}

/* ================= CONTACT ================= */

#contact{
    min-height:85vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    background:var(--cream);
}

.contact-content{
    max-width:750px;
}

.contact-title{
    font-family:"Playfair Display",serif;
    font-size:clamp(60px,9vw,110px);
    line-height:.85;
    letter-spacing:-5px;
}

.contact-title span{
    color:var(--yellow);
    font-style:italic;
}

.contact-description{
    max-width:470px;
    margin:30px auto;
    color:var(--gray);
    font-size:13px;
    line-height:1.9;
}

.email{
    display:inline-block;
    color:#a67b20;
    border-bottom:1px solid #c6a64d;
    padding-bottom:6px;
    font-size:14px;
}

.contact-details{
    margin-top:65px;
    display:flex;
    justify-content:center;
    gap:60px;
    padding-top:25px;
    border-top:1px solid var(--line);
}

.detail span{
    display:block;
    color:#b2872c;
    font-size:9px;
    letter-spacing:2px;
}

.detail strong{
    display:block;
    margin-top:5px;
    color:#555048;
    font-size:12px;
    font-weight:500;
}

/* ================= FOOTER ================= */

footer{
    padding:22px;
    background:#e5cd78;
    text-align:center;
    color:#5e4e27;
    font-size:10px;
    letter-spacing:2px;
}

/* ================= ANIMATION ================= */

@keyframes fadeUp{
    from{
        opacity:0;
        transform:translateY(30px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

@keyframes fadeIn{
    from{
        opacity:0;
        transform:scale(.95);
    }
    to{
        opacity:1;
        transform:scale(1);
    }
}

/* ================= RESPONSIVE ================= */

@media(max-width:900px){

    .home-container,
    .about-grid,
    .project-card{
        grid-template-columns:1fr;
    }

    .home-container{
        text-align:center;
    }

    .home-description{
        margin:auto;
    }

    .home-identity{
        justify-content:center;
    }

    .home-buttons{
        justify-content:center;
    }

    .photo-area{
        margin-top:20px;
    }

    .skills-wrapper{
        grid-template-columns:1fr 1fr;
    }

    .project-visual{
        min-height:350px;
    }
}

@media(max-width:600px){

    nav{
        padding:0 5%;
    }

    .menu{
        gap:10px;
    }

    .menu a{
        font-size:8px;
    }

    section{
        padding:105px 7% 70px;
    }

    .home-title{
        font-size:62px;
        letter-spacing:-4px;
    }

    .home-title span{
        margin-left:30px;
    }

    .photo-area{
        transform:scale(.85);
        margin:-20px 0 -40px;
    }

    .bio-item{
        grid-template-columns:120px 1fr;
        gap:10px;
    }

    .timeline-item{
        grid-template-columns:90px 12px 1fr;
        gap:12px;
    }

    .timeline-content h3{
        font-size:19px;
    }

    .skills-wrapper{
        grid-template-columns:1fr;
    }

    .experience-content{
        grid-template-columns:1fr;
    }

    .experience-main h3{
        font-size:32px;
    }

    .project-info{
        padding:35px;
    }

    .project-info h3{
        font-size:35px;
    }

    .contact-details{
        gap:20px;
        flex-wrap:wrap;
    }
}
</style>
</head>

